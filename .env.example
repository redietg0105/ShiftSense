# GEMINI_API_KEY: Not currently called anywhere in this codebase, but kept
# here for future Gemini AI features. Copy this file to .env.local and set
# a real key if you add code that uses it; server.ts loads .env.local via
# dotenv on startup.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# PORT: Optional. Defaults to 3000 if unset.
# PORT=3000
